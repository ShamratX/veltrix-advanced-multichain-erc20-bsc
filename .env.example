# Wallet used for deployment and contract interactions (without 0x prefix)
PRIVATE_KEY=your_wallet_private_key

# Ethereum RPC endpoints
ETH_SEPOLIA_RPC_URL=your_eth_sepolia_rpc_url
ETH_MAINNET_RPC_URL=your_eth_mainnet_rpc_url

# BNB Chain RPC endpoints
BSC_TESTNET_RPC_URL=your_bsc_testnet_rpc_url
BSC_MAINNET_RPC_URL=your_bsc_mainnet_rpc_url

# Block explorer API keys (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
